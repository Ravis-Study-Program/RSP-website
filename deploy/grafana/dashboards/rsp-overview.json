        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status_class) (rate(rsp_auth_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Auth response rate",
      "type": "timeseries"
    },
    {
      "description": "Origin and rate-limit rejections are the currently exported auth failure signals.",
