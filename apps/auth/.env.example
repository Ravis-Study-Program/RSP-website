# Public same-origin URL used as the Better Auth issuer and OAuth callback base.
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:8080
# Local-only value. Production must use at least 32 bytes of high-entropy secret material.
BETTER_AUTH_SECRET=rsp-local-auth-secret-change-before-production
# Connect as the constrained auth runtime role; Better Auth exclusively owns this schema.
DATABASE_URL=postgresql://rsp_auth:rsp-local-auth-database-password@postgres:5432/rsp?sslmode=disable&options=-c%20search_path%3Dauth

AUTH_HOST=0.0.0.0
AUTH_PORT=3001
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY_HEADERS=true
AUTH_IP_ADDRESS_HEADER=x-real-ip
AUTH_MFA_MAX_AGE_SECONDS=300
RSP_API_AUDIENCE=rsp-api

# Leave both blank to disable Google locally. Both are required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# smtp uses Mailpit locally. Set EMAIL_PROVIDER=ses and AWS_REGION in production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=RSP <no-reply@rsp.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Auth-to-API lifecycle callbacks. Replace this value in every non-local environment.
IDENTITY_SERVICE_URL=http://api:8080
IDENTITY_SERVICE_TOKEN=rsp-local-identity-service-token-change-me
IDENTITY_CALLBACK_TIMEOUT_MS=3000
