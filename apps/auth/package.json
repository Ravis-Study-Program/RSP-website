{
  "name": "@rsp/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "generate-schema": "auth generate --config src/auth.ts --output migrations/better-auth.sql --yes",
    "migrate": "auth migrate --config src/auth.ts --yes",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1109.0",
    "better-auth": "1.6.27",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "auth": "1.6.27",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
