{
  "name": "@rsp/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test",
    "test": "VITE_USE_DEMO_DATA=true vitest run",
    "test:watch": "VITE_USE_DEMO_DATA=true vitest",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "generate": "orval --config orval.config.ts && rm -f src/api/generated/rsp.ts",
    "generate:check": "pnpm generate && git diff --exit-code -- src/api/generated",
    "lint": "eslint src e2e e2e-real *.config.ts --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@hookform/resolvers": "5.2.2",
    "@internationalized/date": "3.12.3",
    "@tabler/icons-react": "3.35.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.87.4",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-link": "3.6.6",
    "@tiptap/react": "3.6.6",
    "@tiptap/starter-kit": "3.6.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.58.0",
    "react": "19.1.1",
    "react-aria-components": "1.12.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.1.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "orval": "8.22.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
