# Copy this file to .env for local development. Values marked local are safe
# only on a developer machine and are rejected by `just prod-up`.

# Browser-facing origin and bound host ports.
PUBLIC_ORIGIN=http://localhost:8080
RSP_PORT=8080
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Optional local image tag used by Compose builds.
IMAGE_TAG=local

# PostgreSQL 17.11 local database. URL-encode reserved characters if changing
# the password because services construct PostgreSQL URLs from these values.
POSTGRES_DB=rsp
POSTGRES_USER=rsp
POSTGRES_PASSWORD=rsp-local-database-password

# Independent runtime credentials. The PostgreSQL superuser above is used only
# to provision these roles; application processes never receive it.
MIGRATION_DB_PASSWORD=rsp-local-migration-database-password
APP_DB_PASSWORD=rsp-local-app-database-password
AUTH_DB_PASSWORD=rsp-local-auth-database-password

# Application security material. Replace each with independent high-entropy
# values outside local development; never commit the replacements.
CURSOR_SECRET=rsp-local-cursor-hmac-secret-change-me
BETTER_AUTH_SECRET=rsp-local-auth-secret-change-before-production
IDENTITY_SERVICE_TOKEN=rsp-local-identity-service-token-change-me

# JWT contract between Better Auth and the Go API.
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=rsp-api
AUTH_JWKS_URL=http://auth:3001/api/auth/jwks

# Browser session and origin policy.
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY_HEADERS=true
AUTH_IP_ADDRESS_HEADER=x-real-ip
AUTH_MFA_MAX_AGE_SECONDS=300

# Explicit isolated-UI/testing switches. Keep both false for the real stack.
DEV_AUTH_BYPASS=false
VITE_USE_DEMO_DATA=false

# Catalogue source used by the scheduled worker. Override only with a
# compatible LeetCode GraphQL endpoint (for example, an approved test stub).
LEETCODE_SYNC_URL=https://leetcode.com/graphql/

# Leave both blank to disable Google locally. Both are mandatory at launch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local mail is captured by Mailpit. Production must use ses and an authorized
# sender; AWS credentials are supplied through the deployment environment or
# workload identity and never this file.
EMAIL_PROVIDER=smtp
EMAIL_FROM="RSP <no-reply@rsp.local>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
AWS_REGION=ap-southeast-2
# Leave blank when the runtime uses workload identity. Otherwise inject these
# from a secret store; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Grafana binds to loopback. Replace the password in every shared environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rsp-local-grafana-password

# Optional legacy source used only by an explicitly supervised import.
LEGACY_DATABASE_URL=
